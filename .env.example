# Copie para .env (o iniciar.ps1 faz isso sozinho e gera senhas aleatorias).
POSTGRES_DB=controle_pessoal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
# Senha do papel app_api, usado pela API para conectar (sem privilegios de dono).
APP_API_SENHA=troque-esta-senha-da-api
# Segredo que assina os tokens de login da API (minimo 32 caracteres; nao compartilhe).
JWT_SECRET=troque-este-segredo-da-api
# Porta da API no seu computador (padrao 3000).
API_PORTA=3000

# Opcional, so para testes: preenche a tela de login quando o app abre pelo web.bat
# LOGIN_TESTE_EMAIL=
# LOGIN_TESTE_SENHA=

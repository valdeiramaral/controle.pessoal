# Copie para .env (o iniciar.ps1 faz isso sozinho e gera senhas aleatorias).
POSTGRES_DB=controle_pessoal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
# Senha do papel app_api, usado pela API para conectar (sem privilegios de dono).
APP_API_SENHA=troque-esta-senha-da-api
